  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.5.0",
    "@google/generative-ai": "^0.24.0",
    "@omnisentinel/shared": "workspace:*",
    "bullmq": "^5.8.2",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.26.2",
    "ioredis": "^5.4.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.44.0",
    "postgres": "^3.4.4",
    "yahoo-finance2": "^2.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
