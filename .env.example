# OmniSentinel Environment Configuration

# Set to true for zero-cost offline development (uses pre-recorded fixtures and mocks)
MOCK_MODE=true

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (Supabase or Local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/omnisentinel

# Redis Broker (Upstash or Local Redis)
REDIS_URL=redis://localhost:6379

# AI Intent Engine (Google AI Studio)
GEMINI_API_KEY=

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Transactional Email (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@omnisentinel.dev
BREVO_SENDER_NAME=OmniSentinel Alerts

# Career Job Aggregator (RapidAPI JSearch)
RAPIDAPI_KEY=

# Visual Proof Screenshot CDN (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
